# Copy to .env and replace placeholders outside source control.
SECRET_KEY=replace-with-a-random-secret
PORT=8000
FRONTEND_ORIGIN=http://localhost:8000
API_PATH=/api
IS_DEMO=false
ALLOW_SELF_REGISTRATION=true

# MCP is disabled by default. Run the additive access-token migration before
# enabling it. Use exact Host header values, including ports when applicable;
# do not use wildcards. Example for the local Compose stack:
MCP_ENABLED=false
MCP_TRUSTED_HOSTS=localhost:8000

# Optional administrator bootstrap. If SUPERUSER_EMAIL is set and the account
# does not exist, SUPERUSER_PASSWORD is required only for that first creation.
# Existing users keep their current password; the configured account is promoted
# to administrator at startup. Keep the password outside source control.
SUPERUSER_EMAIL=
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=

# Default API stack: `docker compose up -d` never starts the worker and stays
# fail-closed because this value defaults to disabled. For an explicit local or
# operational API opt-in, set AUTOMATION_EXECUTION_MODE=real in .env and restart
# the API stack. The worker profile independently sets real and remains opt-in.
AUTOMATION_EXECUTION_MODE=disabled
AUTOMATION_PHASE0_READY=false
UNITTCMS_HERCULES_COMPAT_REAL=0
AUTOMATION_REDIS_URL=redis://redis:6379
AUTOMATION_ARTIFACT_ROOT=/app/backend/private/automation-artifacts

# Opt-in worker profile: these values are read only by `automation-worker`.
AUTOMATION_WORKER_MODULE=./backend/automation/worker-bootstrap.js
# Mandatory UnitTCMS worker HMAC secret file. The host directory below is mounted
# only into the worker; do not mount it on the API service.
AUTOMATION_WORKER_SECRET=
AUTOMATION_WORKER_SECRET_FILE=/run/secrets/automation_worker_secret
AUTOMATION_SECRETS_DIR_HOST=./.secrets
AUTOMATION_HERCULES_WORKDIR=/app/backend/private/hercules-work
# Worker-only named volume shared with the nested Hercules container. Compose
# uses this exact value for the volume name; whitespace, slashes, controls, and
# malformed Docker volume names are rejected by the worker boundary.
AUTOMATION_HERCULES_VOLUME=unittcms_hercules-work
# Production Compose uses a named uploads volume; override it only with a safe
# Docker volume name when the production file is used.
# UNITTCMS_UPLOADS_VOLUME=unittcms_uploads
# Optional override for the opt-in worker only. Leave empty to use the published
# GHCR latest image. For reproducible runs, use a published version tag such as
# ghcr.io/danielrondongarcia/testzeus-hercules:1.0.1. The value must contain one
# Docker image reference with no whitespace or shell/argv fragments.
AUTOMATION_HERCULES_IMAGE=

# Worker-only global LLM settings. Use non-secret provider/model/endpoint values;
# the API service never receives these variables. Use `ollama` for the host daemon
# or `ollama-cloud` for the direct Ollama Cloud API. For local Ollama, use the exact
# tag already shown by `ollama list`; do not use an uninstalled or guessed model name.
HERCULES_LLM_PROVIDER=ollama
HERCULES_LLM_MODEL=replace-with-exact-installed-ollama-tag
LITELLM_BASE_URL=http://host.docker.internal:11434
# Optional provider key for keyed routes only. Ollama does not need this file;
# the worker secret above remains mandatory. The container path is fixed by Compose.
LITELLM_API_KEY_FILE=/run/secrets/litellm_api_key
# Direct Ollama Cloud only. The worker reads this file when the provider is
# `ollama-cloud`; the local `ollama` profile ignores it.
OLLAMA_API_KEY_FILE=/run/secrets/ollama_api_key
# Non-Compose non-production fallback only; unset OLLAMA_API_KEY_FILE before use.
# Never set this value in production or pass it through Compose.
OLLAMA_API_KEY=
# Local non-Compose fallback only; leave empty for Compose/production.
LITELLM_API_KEY=
# UnitTCMS keeps these internal names at its worker boundary. The executor maps
# them only for Hercules to LLM_MODEL_NAME, LLM_MODEL_BASE_URL, and
# LLM_MODEL_API_TYPE (openai-compatible -> openai; ollama/ollama-cloud -> ollama).
# Authenticated providers receive LLM_MODEL_API_KEY; local keyless Ollama omits it.

# Choose one LLM profile
#
# The examples below are intentionally commented. Copy or uncomment exactly
# one provider/model/base URL combination in your local .env; do not enable
# both profiles. The provider and model must be enabled by the gateway/account
# or installed in the local runtime before the worker is activated.
#
# OpenAI or OpenAI-compatible via LiteLLM:
# HERCULES_LLM_PROVIDER=openai-compatible
# Text-only model example (use one model line):
# HERCULES_LLM_MODEL=gpt-4o-mini
# Multimodal/vision model example (use instead of the text-only line):
# HERCULES_LLM_MODEL=gpt-4o
# LITELLM_BASE_URL=https://your-litellm-gateway.example/v1
# The gateway must expose the selected model and the account must have access.
#
# Ollama local (Docker Desktop):
# HERCULES_LLM_PROVIDER=ollama
# Set this to one exact tag from `ollama list` (text-only or vision-capable):
# HERCULES_LLM_MODEL=replace-with-exact-installed-ollama-tag
# LITELLM_BASE_URL=http://host.docker.internal:11434
# The model tags must already exist in the local Ollama installation. On
# Linux, host.docker.internal may require a different reachable host or extra
# Docker host mapping.
# Ollama does not require a provider API key. Do not create
# `.secrets/litellm_api_key` for this profile.
# The worker still requires AUTOMATION_WORKER_SECRET_FILE.
#
# Ollama Cloud direct API:
# HERCULES_LLM_PROVIDER=ollama-cloud
# HERCULES_LLM_MODEL=replace-with-ollama-cloud-model
# LITELLM_BASE_URL=https://ollama.com/api
# OLLAMA_API_KEY_FILE=/run/secrets/ollama_api_key
# Create `.secrets/ollama_api_key` for the worker; never put the key in `.env`.
#
# Vision is needed only when scenarios must interpret screenshots or images.
# Use text-only models for simple navigation and assertions. Consider vision
# for visual captchas, layout, charts, or screenshots, without assuming that
# captchas can be automated successfully. Choosing a multimodal model does not
# create images or automatically enable screenshot uploads: Hercules must
# produce and send the evidence, and the provider must support that request.
# Model quality, cost, and latency are trade-offs; choose for the scenario.

# Configure the project target and redirect allowlist separately in UnitTCMS.
# The hostname from each environment's base URL is allowed automatically.
# Add exact gateway, identity-provider, and MFA hostnames in the project
# environment settings; HERCULES_ALLOWED_HOSTS is generated per execution.

# PowerShell usage (input is never printed; do not paste real secrets here):
# Copy-Item .env.example .env
# $env:SECRET_KEY = [guid]::NewGuid().ToString('N')
# docker compose --env-file .env up -d
# Create .secrets/automation_worker_secret before enabling the opt-in worker
# profile. Create .secrets/ollama_api_key only for the ollama-cloud profile, or
# .secrets/litellm_api_key only for a keyed LiteLLM gateway. Set
# AUTOMATION_PHASE0_READY=true only after the separate Phase-0 compatibility
# evidence has been approved.

# Copy to .env and replace placeholders outside source control.
SECRET_KEY=replace-with-a-random-secret
PORT=8000
FRONTEND_ORIGIN=http://localhost:8000
API_PATH=/api
IS_DEMO=false

# Automation is fail-closed by default. `fake` is for injected tests/dev only.
AUTOMATION_EXECUTION_MODE=disabled
AUTOMATION_PHASE0_READY=false
AUTOMATION_REDIS_URL=redis://redis:6379
AUTOMATION_ARTIFACT_ROOT=/app/backend/private/automation-artifacts
AUTOMATION_WORKER_MODULE=

# Real isolated compatibility runs receive these from CI/secret storage, never source.
LITELLM_BASE_URL=https://replace-with-approved-litellm-endpoint
LITELLM_API_KEY=replace-me
HERCULES_ALLOWED_HOSTS=example.test
